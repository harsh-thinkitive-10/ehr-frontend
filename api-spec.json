  "components": {
    "schemas": {
      "PatientDTO": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string", "format": "uuid" },
          "fullName": { "type": "string" },
          "age": { "type": "integer", "format": "int32" },
          "gender": { "type": "string" },
          "phoneNumber": { "type": "string" },
          "email": { "type": "string" }
        }
      },
      "AdminProfileUpdateRequestDTO": {
        "type": "object",
        "properties": {
          "fullName": { "type": "string" },
          "email": { "type": "string" }
        },
        "required": ["email", "fullName"]
      },
      "Response": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INTERNAL_ERROR",
              "ACCESS_DENIED",
              "USER_NOT_FOUND",
              "USER_ALREADY_EXIST",
              "BAD_REQUEST",
              "NOT_FOUND",
              "CREATED",
              "SERVICE_UNAVAILABLE",
              "UNAUTHORIZED",
              "INVALID_INPUT",
              "INVALID_RESPONSE",
              "LOGOUT_RESPONSE",
              "DB_ERROR",
              "IAM_ERROR",
              "AWS_ERROR",
              "ENTITY",
              "OK",
              "UPDATED",
              "UNSUPPORTED_MEDIA_TYPE",
              "CHECK_CONSULT_TIME",
              "INVALID_TIME_DURATION",
              "PAST_START_TIME",
              "SLOT_ALREADY_BOOKED",
              "SLOT_NOT_FOUND",
              "NO_NOTIFICATIONS",
              "NOTIFICATION_MARKED_AS_SEEN",
              "AWS_EVENT_BRIDGE_SCHEDULER_CONFLICT",
              "TOO_MANY_REQUESTS",
              "CONFLICT"
            ]
          },
          "data": { "type": "object" },
          "message": { "type": "string" }
        }
      },
      "PrescriptionRequestDTO": {
        "type": "object",
        "properties": {
          "medicineName": { "type": "string" },
          "dosage": { "type": "string" },
          "frequency": { "type": "string" },
          "duration": { "type": "integer", "format": "int32" },
          "instructions": { "type": "string" },
          "appointmentUuid": { "type": "string", "format": "uuid" }
        },
        "required": [
          "appointmentUuid",
          "dosage",
          "duration",
          "frequency",
          "medicineName"
        ]
      },
      "RegisterPatient": {
        "type": "object",
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "age": { "type": "integer", "format": "int32" },
          "gender": { "type": "string" },
          "phoneNumber": { "type": "string" },
          "email": { "type": "string" }
        },
        "required": [
          "age",
          "email",
          "firstName",
          "gender",
          "lastName",
          "password",
          "phoneNumber",
          "username"
        ]
      },
      "SetPasswordDTO": {
        "type": "object",
        "properties": { "newPassword": { "type": "string" } },
        "required": ["newPassword"]
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "newPassword": { "type": "string", "maxLength": 128, "minLength": 8 }
        },
        "required": ["newPassword", "token"]
      },
      "ResetPasswordResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" }
        }
      },
      "RefreshTokenRequestDTO": {
        "type": "object",
        "properties": { "refreshToken": { "type": "string" } },
        "required": ["refreshToken"]
      },
      "RefreshTokenResponseDTO": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" },
          "expires_in": { "type": "integer", "format": "int64" },
          "token_type": { "type": "string" }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "properties": { "refreshToken": { "type": "string" } },
        "required": ["refreshToken"]
      },
      "LogoutResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" }
        }
      },
      "LoginDTO": {
        "type": "object",
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" }
        },
        "required": ["password", "username"]
      },
      "LoginResponseDTO": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" },
          "expires_in": { "type": "integer", "format": "int64" }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": { "username": { "type": "string" } },
        "required": ["username"]
      },
      "ForgotPasswordResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" }
        }
      },
      "AppointmentRequestDTO": {
        "type": "object",
        "properties": {
          "appointmentDate": { "type": "string", "format": "date-time" },
          "reasonForVisit": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "SCHEDULED",
              "COMPLETED",
              "PENDING",
              "CHECK_IN",
              "CANCELLED",
              "NO_SHOW",
              "RESCHEDULED",
              "CLOSED"
            ]
          },
          "patientUuid": { "type": "string", "format": "uuid" },
          "doctorUuid": { "type": "string", "format": "uuid" }
        },
        "required": [
          "appointmentDate",
          "doctorUuid",
          "patientUuid",
          "reasonForVisit",
          "status"
        ]
      },
      "DoctorProfileUpdateRequestDTO": {
        "type": "object",
        "properties": {
          "fullName": { "type": "string" },
          "specialization": { "type": "string" },
          "phoneNumber": { "type": "string", "pattern": "^[0-9]{10}$" },
          "email": { "type": "string" },
          "consultationFee": { "type": "number", "minimum": 0.0 }
        },
        "required": ["email", "fullName", "phoneNumber", "specialization"]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": { "type": "string" },
          "newPassword": {
            "type": "string",
            "maxLength": 2147483647,
            "minLength": 8
          }
        },
        "required": ["currentPassword", "newPassword"]
      },
      "ChangePasswordResponseDTO": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" }
        }
      },
      "AppointmentSummary": {
        "type": "object",
        "properties": {
          "upcoming": { "type": "integer", "format": "int64" },
          "completed": { "type": "integer", "format": "int64" }
        }
      },
      "LabReportSummary": {
        "type": "object",
        "properties": { "available": { "type": "integer", "format": "int64" } }
      },
      "MedicalRecordSummary": {
        "type": "object",
        "properties": { "total": { "type": "integer", "format": "int64" } }
      },
